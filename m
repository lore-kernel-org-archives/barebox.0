-	timeout = MUSB_HOST_TIMEOUT;
-	do {
-		if (ctrlc())
-			return -EIO;
-		host->isr(0, host);
-	} while ((urb->dev->status & USB_ST_NOT_PROC) && --timeout);
-
-	return urb->status;
-}
