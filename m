-	m = (reg >> 16) & 0x3ff;
-	p = (reg >> 8) & 0x3f;
-	s = (reg >> 0) & 0x7;
-	s -= 1;
-	return m * ((S5PCXX_CLOCK_REFERENCE) / (p << s));
-}
